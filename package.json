{
  "name": "project-template",
  "description": "",
  "version": "0.0.1",
  "author": "Antoine Caron <antoine@crn-tech.fr>",
  "license": "ISC",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "start": "nest start --env-file .env",
    "start:local": "npm run start -- --entryFile local",
    "start:dev": "npm run start -- --watch",
    "start:debug": "npm run start:dev -- --debug",
    "start:prod": "node dist/main",
    "validate": "npm run lint && npm run build && npm run test",
    "test": "npm run test:unit && npm run test:mutation",
    "test:cov": "npm run test:unit:cov",
    "test:unit": "jest --config ./test/jest-unit.js",
    "test:unit:cov": "npm run test:unit -- --coverage",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.5",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.5",
    "lodash": "^4.17.21",
    "luxon": "^3.5.0",
    "nest-winston": "^1.10.2",
    "nestjs-zod": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.17.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.5",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "@stryker-mutator/typescript-checker": "^8.7.1",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.9",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "dotenv-expand": "^12.0.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
