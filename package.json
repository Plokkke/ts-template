{
  "name": "project-template",
  "description": "",
  "version": "0.0.1",
  "author": "Antoine Caron <antoine@crn-tech.fr>",
  "license": "ISC",
  "scripts": {
    "build": "tsc",
    "start": "dotenvx run -f .env -- nest start",
    "start:local": "npm run start -- --entryFile local",
    "start:dev": "npm run start -- --watch",
    "start:debug": "npm run start:dev -- --debug",
    "start:prod": "node --require dd-trace/init dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "test": "npm run test:unit && npm run test:e2e",
    "test:cov": "npm run test:unit:cov && npm run test:e2e:cov && npm run merge-cov",
    "test:unit": "jest --passWithNoTests --config ./test/jest-unit.js",
    "test:unit:cov": "npm run test:unit -- --coverage",
    "test:e2e": "jest --passWithNoTests --runInBand --forceExit --config ./test/jest-e2e.js",
    "test:e2e:cov": "npm run test:e2e -- --coverage",
    "merge-cov": "npx istanbul-merge --out ./reports/tests/unified/coverage/coverage-final.json ./reports/tests/e2e/coverage/coverage-final.json ./reports/tests/unit/coverage/coverage-final.json; npx istanbul report --include ./reports/tests/unified/coverage/coverage-final.json --dir reports/tests/unified/coverage/lcov-report html",
    "validate": "npm run lint && npm run build && npm run test:cov"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.15",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.15",
    "@nestjs/platform-express": "^11.0.15",
    "@nestjs/swagger": "^11.1.1",
    "@plokkke/nest-health-registry": "^1.0.3",
    "lodash": "^4.17.21",
    "luxon": "^3.6.1",
    "nest-winston": "^1.10.2",
    "nestjs-zod": "^4.3.1",
    "reflect-metadata": "^0.2.2",
    "winston": "^3.17.0",
    "zod": "^3.24.2",
    "zod-validation-error": "^3.4.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.39.1",
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.0.15",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "@stryker-mutator/typescript-checker": "^8.7.1",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.16",
    "@types/luxon": "^3.6.2",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "istanbul-merge": "^2.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  }
}
